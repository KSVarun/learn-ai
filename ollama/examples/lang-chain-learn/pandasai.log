def find_matches(dfs, team1, team2, year):
    matches = 0
    for df in dfs:
        if df['Team1 Name'].iloc[0] == team1 and df['Match Date'].str.contains(str(year)).any() or df['Team2 Name'].iloc[0] == team1 and df['Match Date'].str.contains(str(year)).any():
            matches += 1
        if df['Team1 Name'].iloc[0] == team2 and df['Match Date'].str.contains(str(year)).any() or df['Team2 Name'].iloc[0] == team2 and df['Match Date'].str.contains(str(year)).any():
            matches += 1
    return matches


